{
  "name": "@workflow-engine/core",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "./di/*.js": {
      "types": "./dist/src/di/*.d.ts",
      "default": "./dist/src/di/*.js"
    },
    "./db/*.js": {
      "types": "./dist/src/db/*.d.ts",
      "default": "./dist/src/db/*.js"
    },
    "./errors/*.js": {
      "types": "./dist/src/errors/*.d.ts",
      "default": "./dist/src/errors/*.js"
    },
    "./logging/*.js": {
      "types": "./dist/src/logging/*.d.ts",
      "default": "./dist/src/logging/*.js"
    },
    "./config/*.js": {
      "types": "./dist/src/config/*.d.ts",
      "default": "./dist/src/config/*.js"
    },
    "./services/*.js": {
      "types": "./dist/src/services/*.d.ts",
      "default": "./dist/src/services/*.js"
    },
    "./amqp/*.js": {
      "types": "./dist/src/amqp/*.d.ts",
      "default": "./dist/src/amqp/*.js"
    },
    "./test/*.js": "./test/*.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "dev": "tsc-alias -p tsconfig.build.json --watch",
    "clean:bundles": "rm -rf dist",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "amqplib": "^2.0.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@testcontainers/rabbitmq": "^12.1.0",
    "@types/pg": "^8.21.0",
    "testcontainers": "^12.1.0",
    "vitest": "^4.1.10"
  }
}
