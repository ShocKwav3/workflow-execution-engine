meta {
  name: Get Workflow Version
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/workflows/:workflowId/versions/:version
  body: none
  auth: none
}

params:path {
  workflowId: {{workflowId}}
  version: {{versionId}}
}

docs {
  # Get Workflow Version

  Fetches one version by its `id`. Response does **not** embed its nodes — use
  **List Nodes** for that (two representations of one collection would drift).
}
