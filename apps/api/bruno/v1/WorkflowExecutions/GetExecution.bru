meta {
  name: Get Execution
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/workflows/:workflowId/executions/:executionId
  body: none
  auth: none
}

params:path {
  workflowId: {{workflowId}}
  executionId: {{executionId}}
}

docs {
  # Get Execution

  Fetches one workflow-level execution by ID. `{{executionId}}` is auto-filled by
  **Create Execution**.
}
