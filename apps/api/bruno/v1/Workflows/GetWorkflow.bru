meta {
  name: Get Workflow
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/workflows/:workflowId
  body: none
  auth: none
}

params:path {
  workflowId: {{workflowId}}
}

docs {
  # Get Workflow

  Fetches a single workflow by ID. `{{workflowId}}` is auto-filled by **Create Workflow**;
  override it to look up a different one.
}
