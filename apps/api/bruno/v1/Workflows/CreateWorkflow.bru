meta {
  name: Create Workflow
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/workflows
  body: json
  auth: none
}

body:json {
  {
    "name": "Order Fulfillment"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("workflowId", res.body.id);
  }
}

docs {
  # Create Workflow

  Creates a workflow definition. This does **not** create a version or make it runnable —
  a workflow starts with zero versions.

  ## Next step
  Run **Create Workflow Version** to add a draft version. This request auto-fills
  `{{workflowId}}` from the response for every other request in this collection.

  ## Response
  `201 Created` with the workflow, `id`, `name`, `createdAt`, `updatedAt`.
}
