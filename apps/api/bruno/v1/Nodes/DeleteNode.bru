meta {
  name: Delete Node
  type: http
  seq: 6
}

delete {
  url: {{baseUrl}}/api/v1/nodes/:nodeId
  body: none
  auth: none
}

params:path {
  nodeId: {{nodeId}}
}

docs {
  # Delete Node

  **Not part of the main flow** — removes a node from a `DRAFT` version (`409` once
  `PUBLISHED`). Only use against a node you don't intend to publish.
}
