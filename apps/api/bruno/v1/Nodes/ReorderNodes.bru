meta {
  name: Reorder Nodes
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api/v1/workflows/:workflowId/versions/:version/nodes
  body: json
  auth: none
}

params:path {
  workflowId: {{workflowId}}
  version: {{versionId}}
}

body:json {
  {
    "nodeIds": ["{{nodeId}}"]
  }
}

docs {
  # Reorder Nodes

  Whole-collection replace, not a per-node move — `nodeIds` must list **every** node
  currently in the version, in the new desired order. A partial or mismatched list
  returns `409 NODE_ORDERING_MISMATCH`. DRAFT only (`409` if `PUBLISHED`).

  If you've created more than one node, list all their IDs here in the order you want.
}
