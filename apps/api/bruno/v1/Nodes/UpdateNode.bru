meta {
  name: Update Node
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/api/v1/nodes/:nodeId
  body: json
  auth: none
}

params:path {
  nodeId: {{nodeId}}
}

body:json {
  {
    "name": "Reserve Stock"
  }
}

docs {
  # Update Node

  Edits a node's `name`/`type`. Only works while the parent version is still `DRAFT`
  (`409` once `PUBLISHED`).
}
