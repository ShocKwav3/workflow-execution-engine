meta {
  name: Get Workflow Execution Nodes
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/workflows/:workflowId/executions/:executionId/nodes
  body: none
  auth: none
}

params:path {
  workflowId: {{workflowId}}
  executionId: {{executionId}}
}

docs {
  # Get Workflow Execution Nodes

  Lists the `node_execution` rows snapshotted for this execution — one per node in the
  published version, all `PENDING` until an executor exists.
}
