meta {
  name: Get Execution History
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/workflows/:workflowId/executions/:executionId/history
  body: none
  auth: none
}

params:path {
  workflowId: {{workflowId}}
  executionId: {{executionId}}
}

docs {
  # Get Execution History

  Nested view: each node with its attempts grouped underneath (vs. **Get Workflow
  Execution Nodes**' flat list). Each time the executor starts a node it records an
  attempt (`RUNNING`, then `COMPLETED`). If a worker is lost mid-node, the node runs again
  as a new attempt and the interrupted one is marked `ABANDONED`.
}
