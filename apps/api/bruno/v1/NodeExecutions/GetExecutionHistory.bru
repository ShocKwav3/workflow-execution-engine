meta {
  name: Get Execution History
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/workflows/:workflowId/executions/:executionId/history
  body: none
  auth: none
}

params:path {
  workflowId: {{workflowId}}
  executionId: {{executionId}}
}

docs {
  # Get Execution History

  Nested view: each node with its attempts grouped underneath (vs. **Get Workflow
  Execution Nodes**' flat list). `attempts` stays empty for every node until an
  executor exists.
}
