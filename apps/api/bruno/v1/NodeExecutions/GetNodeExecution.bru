meta {
  name: Get Node Execution
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/nodes/:nodeId/executions/:executionId
  body: none
  auth: none
}

params:path {
  nodeId: {{nodeId}}
  executionId: {{executionId}}
}

docs {
  # Get Node Execution

  Node-level address, distinct from the workflow-level execution routes — never confused
  via the URL alone, since a node-level run always nests under `/nodes/{nodeId}`, never
  under a shared `/executions` collection.
}
