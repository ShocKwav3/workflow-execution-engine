{
  "name": "@workflow-engine/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/src/index.js",
    "dev": "LOG_PRETTY=true tsc-watch -p tsconfig.build.json --noClear --onSuccess \"sh -c 'tsc-alias -p tsconfig.build.json && exec node dist/src/index.js'\"",
    "generate:openapi": "node dist/scripts/generateOpenApiSpec.js",
    "clean:bundles": "rm -rf dist"
  },
  "dependencies": {
    "@workflow-engine/core": "workspace:*",
    "@fastify/helmet": "^13.1.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "fastify": "^5.12.0",
    "fastify-type-provider-zod": "^7.0.0",
    "zod": "^4.4.3"
  }
}
