{
  "name": "@workflow-engine/outbox-publisher",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/src/index.js",
    "dev": "tsc -b tsconfig.build.json --watch --preserveWatchOutput & tsc-alias -p tsconfig.build.json --watch & LOG_PRETTY=true exec node --watch-preserve-output --watch-path=./dist/src dist/src/index.js",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "clean:bundles": "rm -rf dist"
  },
  "dependencies": {
    "@workflow-engine/core": "workspace:*",
    "amqplib": "^2.0.1"
  },
  "devDependencies": {
    "vitest": "^4.1.10"
  }
}
