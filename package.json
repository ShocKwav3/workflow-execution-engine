{
  "name": "workflow-engine",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write . --log-level warn",
    "generate:openapi": "pnpm build && node dist/api/scripts/generateOpenApiSpec.js",
    "lint:spec": "spectral lint apps/api/spec/*/openapi.yaml",
    "build": "tsc && tsc-alias",
    "start": "node dist/api/src/index.js",
    "dev": "LOG_PRETTY=true tsc-watch --noClear --onSuccess \"sh -c 'tsc-alias && exec node dist/api/src/index.js'\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.17.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "^26.0.0"
  },
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stoplight/spectral-cli": "^6.16.3",
    "@stoplight/spectral-owasp-ruleset": "^2.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "testcontainers": "^12.1.0",
    "tsc-alias": "^1.9.2",
    "tsc-watch": "^7.2.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@fastify/helmet": "^13.1.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "fastify": "^5.12.0",
    "fastify-type-provider-zod": "^7.0.0",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  }
