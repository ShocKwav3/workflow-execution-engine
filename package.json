{
  "name": "workflow-engine",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "dev": "tsc --build --watch --preserveWatchOutput",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write . --log-level warn",
    "generate:openapi": "pnpm build && pnpm --filter @workflow-engine/api generate:openapi",
    "lint:spec": "spectral lint apps/api/spec/*/openapi.yaml",
    "clean:bundles": "pnpm -r clean:bundles",
    "clean:modules": "rm -rf node_modules apps/*/node_modules packages/*/node_modules"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.17.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "^26.0.0"
  },
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stoplight/spectral-cli": "^6.16.3",
    "@stoplight/spectral-owasp-ruleset": "^2.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "tsc-alias": "^1.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
